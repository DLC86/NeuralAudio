+void HyperWaveNet::ConfigureWeightSmoothing(const int transition_frames, const int step_frames) noexcept
+{
+  const bool was_enabled = _smooth_frames > 0;
+  _smooth_frames = std::max(0, transition_frames);
+  _smooth_step_frames = std::max(1, step_frames);
+  _smooth_step_remaining = 0;
+  if (_smooth_frames == 0)
+    _smooth_position = 0; // process() commits the pending target without interpolation.
+  else if (!was_enabled)
+    _smooth_position = _smooth_frames; // Merely enabling smoothing must not trigger a ramp.
+}
+
+bool HyperWaveNet::HasActiveWeightSmoothing() const noexcept
+{
+  return _smooth_frames > 0 && _has_applied_weights && _smooth_position < _smooth_frames;
+}
+
 void HyperWaveNet::process(NAM_SAMPLE** input, NAM_SAMPLE** output, const int num_frames)
 {
   DebugParamApiGuard guard(_debug_param_api_active);
+  if (num_frames <= 0) return;
 
   if (_dirty)
   {
+    // Only ONE expensive hypernetwork evaluation for the new destination.
     _hypernet.ApplyConditioning(_base_weights, _params, _conditioned);
-    WaveNet::set_weights_(_conditioned);
+    if (!_has_applied_weights || _smooth_frames == 0)
+    {
+      // Initial model state, Reset/prewarm and Crossfade retain exact weights.
+      std::copy(_conditioned.begin(), _conditioned.end(), _smoothed_weights.begin());
+      WaveNet::set_weights_(_smoothed_weights);
+      _has_applied_weights = true;
+      _smooth_position = _smooth_frames;
+    }
+    else if (_smoothed_weights == _conditioned)
+    {
+      // Different control positions can generate identical weights. Avoid
+      // needless segmentation and preserve sample-exact unchanged audio.
+      _smooth_position = _smooth_frames;
+    }
+    else
+    {
+      // A second request during a ramp starts from the current *audible*
+      // weight vector. No second audio network or allocation is required.
+      std::copy(_smoothed_weights.begin(), _smoothed_weights.end(), _start_weights.begin());
+      _smooth_position = 0;
+      _smooth_step_remaining = 0;
+    }
     _dirty = false;
   }
-  WaveNet::process(input, output, num_frames);
+
+  if (_smooth_frames == 0)
+  {
+    // Switching from Eco to Crossfade commits any still-ramping target.
+    if (_has_applied_weights && _smoothed_weights != _conditioned)
+    {
+      std::copy(_conditioned.begin(), _conditioned.end(), _smoothed_weights.begin());
+      WaveNet::set_weights_(_smoothed_weights);
+    }
+    WaveNet::process(input, output, num_frames);
+    return;
+  }
+  if (!HasActiveWeightSmoothing())
+  {
+    WaveNet::process(input, output, num_frames);
+    return;
+  }
+
+  int offset = 0;
+  while (offset < num_frames && _smooth_position < _smooth_frames)
+  {
+    if (_smooth_step_remaining == 0)
+    {
+      // Keep a fixed 0.5 ms grid across host/resampler blocks, so short
+      // buffers do not force an expensive coefficient reload every call.
+      const float position = static_cast<float>(_smooth_position) / static_cast<float>(_smooth_frames);
+      const float alpha = position * position * (3.0f - 2.0f * position);
+      for (size_t i = 0; i < _smoothed_weights.size(); ++i)
+        _smoothed_weights[i] = _start_weights[i] + alpha * (_conditioned[i] - _start_weights[i]);
+      WaveNet::set_weights_(_smoothed_weights);
+      _smooth_step_remaining = std::min(_smooth_step_frames, _smooth_frames - _smooth_position);
+    }
+    const int step = std::min(num_frames - offset, _smooth_step_remaining);
+    for (size_t ch = 0; ch < _smooth_input_ptrs.size(); ++ch)
+      _smooth_input_ptrs[ch] = input[ch] + offset;
+    for (size_t ch = 0; ch < _smooth_output_ptrs.size(); ++ch)
+      _smooth_output_ptrs[ch] = output[ch] + offset;
+    WaveNet::process(_smooth_input_ptrs.data(), _smooth_output_ptrs.data(), step);
+    offset += step;
+    _smooth_position += step;
+    _smooth_step_remaining -= step;
+    if (_smooth_position == _smooth_frames)
+    {
+      std::copy(_conditioned.begin(), _conditioned.end(), _smoothed_weights.begin());
+      WaveNet::set_weights_(_smoothed_weights);
+    }
+  }
+  if (offset < num_frames)
+  {
+    for (size_t ch = 0; ch < _smooth_input_ptrs.size(); ++ch)
+      _smooth_input_ptrs[ch] = input[ch] + offset;
+    for (size_t ch = 0; ch < _smooth_output_ptrs.size(); ++ch)
+      _smooth_output_ptrs[ch] = output[ch] + offset;
+    WaveNet::process(_smooth_input_ptrs.data(), _smooth_output_ptrs.data(), num_frames - offset);
+  }
 }
 
