 /// WaveNet whose weights are regenerated from the controls by a hypernetwork.
 ///
-/// This model does NOT smooth (see IParametricControl). Its controls reach the audio only by
-/// regenerating weights, and weights can only change between process() calls, so its transfer
-/// function is quantised to the block grid no matter what. Ramping does not remove that
-/// discontinuity, only relocate it -- from the host's control-commit rate up to the block
-/// rate, where it is a clearly audible tone -- while regenerating the whole weight set every
-/// block. It was implemented, measured and removed; do not add it back without measuring both
-/// the spectrum and the cost. test_hyperwavenet_applies_immediately() carries the numbers.
+/// By default this model does not smooth: every changed control vector regenerates
+/// and installs the complete weight set before the next process() call.
+/// The optional plugin-side weight interpolation is explicitly enabled through
+/// ConfigureWeightSmoothing(). Unlike older control-parameter ramps (which
+/// recalculated the hypernetwork every block), it runs the hypernetwork only
+/// once per destination and interpolates *weights*, with one DSP network.
+
 class HyperWaveNet : public WaveNet, public IParametricControl
 {
 public:
@@ -46,6 +46,13 @@
 
   void process(NAM_SAMPLE** input, NAM_SAMPLE** output, int num_frames) override;
 
+  // Opt-in, allocation-free single-network weight interpolation. The
+  // hypernetwork runs once per SetParams; intermediate updates only load
+  // interpolated weights into the *same* WaveNet. 0 disables smoothing.
+  // Intended for model sample rate. The host must serialize this with process.
+  void ConfigureWeightSmoothing(int transition_frames, int step_frames) noexcept;
+  [[nodiscard]] bool HasActiveWeightSmoothing() const noexcept;
+
